{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-relay.invalid/schemas/refactoring-recipes.schema.json",
  "title": "Verified refactoring recipe catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recipes"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "schemaVersion": {"type": "integer", "const": 1},
    "recipes": {
      "type": "array",
      "items": {"$ref": "#/$defs/recipe"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\u0000]+$"},
      "uniqueItems": true
    },
    "commandList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "engine", "toolVersion", "risk", "languages", "include", "exclude", "prohibitions", "preconditions", "invariants", "budgets", "fixtures", "verification", "ownership", "compatibility"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"},
        "engine": {"enum": ["ast-grep"]},
        "toolVersion": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]*$"},
        "risk": {"enum": ["R0", "R1", "R2", "R3"]},
        "languages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "parser": {"type": "string", "enum": ["kotlin", "java", "python", "bash", "yaml", "json"]},
        "rule": {"type": "object", "additionalProperties": false, "required": ["pattern"], "properties": {"pattern": {"type": "string", "minLength": 1}, "rewrite": {"type": "string", "minLength": 1}}},
        "include": {"$ref": "#/$defs/pathList"},
        "exclude": {"$ref": "#/$defs/pathList"},
        "prohibitions": {"type": "array", "minItems": 1, "items": {"enum": ["generated", "vendored", "private", "binary", "build", "coordinator"]}, "uniqueItems": true},
        "preconditions": {"$ref": "#/$defs/commandList"},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "behaviorChange": {"enum": ["none", "review-required", "unknown"]},
        "budgets": {"type": "object", "additionalProperties": false, "required": ["maxMatches", "maxFiles", "maxChangedLines", "convergesInOnePass"], "properties": {"maxMatches": {"type": "integer", "minimum": 0}, "maxFiles": {"type": "integer", "minimum": 0}, "maxChangedLines": {"type": "integer", "minimum": 0}, "convergesInOnePass": {"type": "boolean"}}},
        "fixtures": {"type": "object", "additionalProperties": false, "required": ["positive", "negative", "golden"], "properties": {"positive": {"$ref": "#/$defs/pathList"}, "negative": {"$ref": "#/$defs/pathList"}, "golden": {"$ref": "#/$defs/pathList"}}},
        "verification": {"type": "object", "additionalProperties": false, "required": ["focused", "full"], "properties": {"focused": {"$ref": "#/$defs/commandList"}, "full": {"$ref": "#/$defs/commandList"}}},
        "ownership": {"type": "object", "additionalProperties": false, "required": ["maintainer", "status"], "properties": {"maintainer": {"type": "string", "minLength": 1}, "status": {"enum": ["experimental", "allowlisted", "deprecated"]}, "deprecatedReason": {"type": "string", "minLength": 1}}},
        "compatibility": {"type": "object", "additionalProperties": false, "required": ["catalogVersion", "minimumRefactorctl"], "properties": {"catalogVersion": {"type": "integer", "minimum": 1}, "minimumRefactorctl": {"type": "string", "minLength": 1}}}
      }
    }
  }
}
