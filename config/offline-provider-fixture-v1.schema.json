{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-relay.dev/schemas/offline-provider-fixture-v1.json",
  "title": "Agent Relay offline provider fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "evidence", "limits", "matching", "timeline", "outcome"],
  "properties": {
    "schemaVersion": {"const": 1},
    "fixtureId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["tier", "synthetic", "sourceRevision"],
      "properties": {
        "tier": {"const": "synthetic-runtime"}, "synthetic": {"const": true},
        "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxBodyBytes", "maxFrames", "maxEvents", "maxVirtualMillis", "maxRetries"],
      "properties": {
        "maxBodyBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "maxFrames": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maxEvents": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maxVirtualMillis": {"type": "integer", "minimum": 1, "maximum": 3600000},
        "maxRetries": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "matching": {
      "type": "object", "additionalProperties": false,
      "required": ["requestFields", "normalization"],
      "properties": {
        "requestFields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}},
        "normalization": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/normalizer"}}
      }
    },
    "timeline": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {"$ref": "#/$defs/frame"}
    },
    "faults": {
      "type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/fault"}
    },
    "outcome": {"$ref": "#/$defs/outcome"}
  },
  "$defs": {
    "normalizer": {
      "type": "object", "additionalProperties": false, "required": ["field", "operation"],
      "properties": {"field": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}, "operation": {"enum": ["exact", "trim", "lowercase", "redact-id", "redact-timestamp", "sort-keys"]}}
    },
    "frame": {
      "type": "object", "additionalProperties": false, "required": ["atMillis", "direction", "kind", "payload"],
      "properties": {
        "atMillis": {"type": "integer", "minimum": 0}, "direction": {"enum": ["request", "response"]},
        "kind": {"enum": ["agent-event", "tool-call", "tool-result", "approval", "terminal"]},
        "payload": {"type": "object", "additionalProperties": true}
      }
    },
    "fault": {
      "type": "object", "additionalProperties": false, "required": ["atMillis", "kind"],
      "properties": {
        "atMillis": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["disconnect", "truncate", "malformed", "rate-limit", "process-exit", "cancel", "duplicate", "gap", "uncertain-delivery"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "detail": {"type": "string", "maxLength": 256}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false, "required": ["status", "consumedFrames", "consumedEvents"],
      "properties": {
        "status": {"enum": ["success", "cancelled", "failed", "uncertain"]},
        "consumedFrames": {"type": "integer", "minimum": 0}, "consumedEvents": {"type": "integer", "minimum": 0},
        "errorCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{2,63}$"}
      }
    }
  }
}
