<!-- App-widget hosts do not paint the application's window background; this root owns its surface. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/home_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_widget_status_quiet"
        android:textColor="@color/widget_secondary_text"
        android:textDirection="locale"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/home_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/home_widget_no_attention"
        android:textColor="@color/widget_primary_text"
        android:textDirection="locale"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_widget_item_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:textColor="@color/widget_primary_text" />

    <TextView
        android:id="@+id/home_widget_item_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:textColor="@color/widget_primary_text" />

    <TextView
        android:id="@+id/home_widget_item_three"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:textColor="@color/widget_primary_text" />

    <LinearLayout
        android:id="@+id/home_widget_actions"
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/home_widget_acknowledge"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_widget_action_acknowledge"
            android:textColor="@color/widget_action_text"
            android:visibility="gone" />

        <Button
            android:id="@+id/home_widget_defer"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_widget_action_defer"
            android:textColor="@color/widget_action_text"
            android:visibility="gone" />

        <Button
            android:id="@+id/home_widget_mute"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_widget_action_mute_confirm"
            android:textColor="@color/widget_action_text"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
