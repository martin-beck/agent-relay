<!-- App-widget hosts do not paint the application's window background; this root owns its surface. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/lock_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lock_widget_status_quiet"
        android:textColor="@color/widget_secondary_text"
        android:textDirection="locale"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/lock_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/lock_widget_no_attention"
        android:textColor="@color/widget_primary_text"
        android:textDirection="locale"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
