<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/lock_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lock_widget_status_quiet"
        android:textColor="@color/widget_secondary_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/lock_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/lock_widget_no_attention"
        android:textColor="@color/widget_primary_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
